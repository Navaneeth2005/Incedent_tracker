# MongoDB Connection String
# Local: mongodb://localhost:27017/incident-room
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/incident-room
MONGODB_URI=mongodb://localhost:27017/incident-room

# Server Port
PORT=3001

# OpenAI API Key (optional - fallback mode works without it)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173