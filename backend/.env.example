# ==============================================
# Backend Environment Variables
# ==============================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/incident-room

# Server Port - IMPORTANT: Render provides this automatically
PORT=10000

# OpenAI API Key (optional - leave empty for fallback AI mode)
OPENAI_API_KEY=

# Frontend URL for CORS - Replace with your Vercel URL
FRONTEND_URL=https://your-app.vercel.app

# Node Environment
NODE_ENV=production